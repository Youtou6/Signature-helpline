# Discord bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# The application (client) ID of your bot (Developer Portal > General Information)
CLIENT_ID=

# The ID of your "Signature" Discord server (right-click server icon > Copy Server ID)
GUILD_ID=

# Password used to log into the visual dashboard (choose something strong)
DASHBOARD_PASSWORD=

# Random string used to sign the dashboard session cookie (any long random text)
SESSION_SECRET=

# Render sets this automatically, only needed for local testing
PORT=3000
